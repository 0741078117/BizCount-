// ============================================================
// FIRESTORE SECURITY RULES — bizcount-d1064
//
// HOW TO DEPLOY:
// 1. Go to Firebase Console → Firestore Database → Rules
// 2. Replace the content with these rules
// 3. Click "Publish"
// ============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Owner data — private, owner-only ──────────────────────
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{collection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ── Staff auth — public read, authenticated owner write ────
    // Contains: name, pin, staffUID, ownerUID, productsSnapshot, settingsSnapshot
    // No payment or debt data is stored here — safe to read publicly.
    match /staffAuth/{phoneKey} {
      // Anyone can read (staff login on any device, no auth required)
      allow read: if true;

      // Only authenticated users can write
      // First create: any authenticated user (owner creating their staff doc)
      allow create: if request.auth != null;

      // Updates: only the original owner (stored as ownerUID)
      allow update, delete: if request.auth != null
                            && request.auth.uid == resource.data.ownerUID;
    }

  }
}
