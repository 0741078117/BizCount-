// ============================================================
// FIRESTORE SECURITY RULES — bizcount-d1064
// 
// HOW TO DEPLOY:
// 1. Go to Firebase Console → Firestore Database → Rules
// 2. Replace the content with these rules
// 3. Click "Publish"
// ============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can only access their own data
    // Path: /users/{userId}/...
    match /users/{userId} {
      
      // Allow user to read/write their own profile
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Allow user to read/write their own sub-collections
      // (products, sales, debts, expenses, withdrawals, daily_savings)
      match /{collection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
