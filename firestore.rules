// ============================================================
// FIRESTORE SECURITY RULES — bizcount-d1064
//
// HOW TO DEPLOY:
// 1. Go to Firebase Console → Firestore Database → Rules
// 2. Replace the content with these rules
// 3. Click "Publish"
// ============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Owner data — private, owner-only ──────────────────────
    // Path: /users/{userId}/...
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{collection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ── Staff auth — public read, owner-only write ─────────────
    // Path: /staffAuth/{ownerPhone}
    // Contains ONLY: name, pin, ownerUID, updatedAt
    // No financial data is stored here — safe to read publicly.
    match /staffAuth/{ownerPhone} {
      // Anyone can read (needed for staff login from any device)
      allow read: if true;

      // Only the owner (authenticated + UID matches stored ownerUID) can write
      allow write: if request.auth != null
                   && request.auth.uid == resource.data.ownerUID;

      // Allow first-time create by any authenticated user
      // (owner creates their own staffAuth entry when saving staff account)
      allow create: if request.auth != null;
    }

  }
}
